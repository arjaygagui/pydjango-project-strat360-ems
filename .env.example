# Copy to .env and fill in. Never commit .env (it's in .gitignore).
# One KEY=value per line; comments go on their own line (text after a value is kept as part of it).

# ---------- Django ----------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# True only on your own machine
DJANGO_DEBUG=False
# Comma-separated host names the site answers to
DJANGO_ALLOWED_HOSTS=ems.example.gov.ph
# Full origins allowed to submit forms
DJANGO_CSRF_TRUSTED_ORIGINS=https://ems.example.gov.ph
# Path the app is served under on a shared server, e.g. strat360/ -> https://host/strat360/ (empty = site root)
DJANGO_URL_PREFIX=
# Move the admin off the obvious path, e.g. staff-7f3k/
DJANGO_ADMIN_URL=admin/
# True when nginx / a load balancer / a PaaS terminates HTTPS in front of the app
DJANGO_BEHIND_PROXY=True
DJANGO_SSL_REDIRECT=True
# Raise to 31536000 (1 year) once HTTPS is confirmed working
DJANGO_HSTS_SECONDS=3600
DJANGO_LOG_LEVEL=WARNING

# ---------- Voter roll: cvl_national (use a READ-ONLY account) ----------
RDS_HOST=your-rds-endpoint.ap-southeast-1.rds.amazonaws.com
RDS_PORT=3306
RDS_NAME=cvl_national
RDS_USER=strat360_ro
RDS_PASSWORD=

# ---------- EMS changes: generic_360_db (limited read/write account) ----------
# Leave EXT_DB_USER / EXT_DB_PASSWORD out to reuse the RDS_* account.
EXT_DB_NAME=generic_360_db
EXT_DB_USER=strat360_rw
EXT_DB_PASSWORD=

# ---------- AI Analytics (optional) ----------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------- Sign-in lockout ----------
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
